# Copy this file to .env.local for local development
# Never commit .env.local to git

# ─── Database ───────────────────────────────────────────────
# Get this from Railway > your project > PostgreSQL service > Variables
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://approachmedia.in"

# ─── Admin Auth (simple secret for Step 3 admin panel) ──────
ADMIN_SECRET="change-this-to-a-long-random-string"

# ─── Email (Resend) ─────────────────────────────────────────
# Sign up at https://resend.com — verify approachmedia.in domain — paste API key below
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# ─── Google Tag Manager (optional) ──────────────────────────
# Container ID, e.g. GTM-XXXXXXX. Leave unset and no tag loads. The privacy
# policy discloses the container only when this is set.
NEXT_PUBLIC_GTM_ID=""
